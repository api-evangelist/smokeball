{
  "opencollection": "1.0.0",
  "info": {
    "name": "Smokeball Activity Codes API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Activity Codes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an activity code",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smokeball.com/activitycodes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a specified activity code."
        },
        {
          "info": {
            "name": "Update an activity code",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.smokeball.com/activitycodes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an activity code."
        },
        {
          "info": {
            "name": "Delete an activity code",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.smokeball.com/activitycodes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes an activity code."
        },
        {
          "info": {
            "name": "Get activity codes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smokeball.com/activitycodes",
            "params": [
              {
                "name": "Offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "Limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "UpdatedSince",
                "value": "",
                "type": "query",
                "description": "Returns expenses updated since a specified time (.net ticks representation of the UTC datetime)."
              }
            ]
          },
          "docs": "Returns a list of activity codes."
        },
        {
          "info": {
            "name": "Create an activity code",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.smokeball.com/activitycodes",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates an activity code."
        }
      ]
    }
  ],
  "bundled": true
}