{
  "opencollection": "1.0.0",
  "info": {
    "name": "Smokeball Activity Codes Referral Types API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Referral Types",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get referral types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smokeball.com/referraltypes"
          },
          "docs": "Returns referral types, including custom referral types."
        },
        {
          "info": {
            "name": "Get a referral type",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smokeball.com/referraltypes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a specified referral type."
        }
      ]
    }
  ],
  "bundled": true
}