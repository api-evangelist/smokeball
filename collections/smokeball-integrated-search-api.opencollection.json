{
  "opencollection": "1.0.0",
  "info": {
    "name": "Smokeball Activity Codes Integrated Search API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Integrated Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get mapping",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smokeball.com/matters/:matterId/integrated-search/mapping",
            "params": [
              {
                "name": "matterId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves integrated search mapping data associated with the authenticated client.\r\n            \r\nUses the integrated search provider used by the firm (e.g. InfoTrack)."
        }
      ]
    }
  ],
  "bundled": true
}