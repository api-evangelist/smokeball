{
  "opencollection": "1.0.0",
  "info": {
    "name": "Smokeball Activity Codes Matter Items API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Matter Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get items on a matter",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smokeball.com/matters/:matterId/items",
            "params": [
              {
                "name": "matterId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a list of items on the specified matter."
        },
        {
          "info": {
            "name": "Get an item on a matter",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smokeball.com/matters/:matterId/items/:id",
            "params": [
              {
                "name": "matterId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns an item on the specified matter."
        }
      ]
    }
  ],
  "bundled": true
}