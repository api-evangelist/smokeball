        {
          "id": "083359ef-2552-47ec-b0ee-1c3a85065f0c",
          "name": "Get matter types",
          "request": {
            "name": "Get matter types",
            "description": {
              "content": "Returns a paginated list of matter types based on search criteria. Deleted matter types are not included.\r\n\r\nNote: If no `Location` is provided, all matter types from all locations will be returned.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mattertypes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "Offset",
                  "value": "<integer>"
                },
                {
                  "disabled": false,
                  "key": "Limit",
                  "value": "<integer>"
                },
                {
                  "disabled": false,
                  "key": "Name",
                  "value": "<string>",
                  "description": "Searches for partial match on matter type name"
                },
                {
                  "disabled": false,
                  "key": "Location",
                  "value": "<string>",
                  "description": "Return matter types from a specific location. In the US API this is the ANSI 2 letter state code (e.g. IL, NY). In the AU API this is shorthand state code (e.g. NSW, ACT, etc)"
                },
                {
                  "disabled": false,
                  "key": "Category",
                  "value": "<string>",
                  "description": "Return matter types from a specific category."
                },
                {
                  "disabled": false,
                  "key": "Type",
                  "value": "<integer>",
                  "description": "Return matter types by category type (i.e. MatterType or LeadType).\r\n            \r\nPossible values: Matter Type = 0, Lead Type = 1."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
