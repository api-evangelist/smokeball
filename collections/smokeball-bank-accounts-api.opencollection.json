      },
      "items": [
        {
          "info": {
            "name": "Get a bank account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smokeball.com/bankaccounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a specified bank account."
        },
        {
          "info": {
            "name": "Get bank accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smokeball.com/bankaccounts",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query"
              },
              {
                "name": "matterId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of bank accounts."
