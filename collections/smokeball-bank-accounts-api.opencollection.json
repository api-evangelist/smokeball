              },
              {
                "name": "Limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "LastUpdated",
                "value": "2022-04-23T14:00:00Z",
                "type": "query",
                "description": "Returns items updated since the specified date and time."
              },
              {
                "name": "MatterId",
                "value": "da4e7fd1-5394-4ca9-b1c6-e18c4e2bf262",
                "type": "query",
                "description": "Filters items by the specified matter ID."
