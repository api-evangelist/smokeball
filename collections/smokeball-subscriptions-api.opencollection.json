        {
          "info": {
            "name": "Get subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smokeball.com/subscriptions"
          },
          "docs": "Returns a list of all available subscriptions with their current status and details.\r\n\r\nThe response includes:\r\n* Subscription IDs\r\n* Current tier\r\n* Active add-ons\r\n* Subscription status"
        },
