{
  "opencollection": "1.0.0",
  "info": {
    "name": "Smokeball Activity Codes Notifications API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Notifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a notification",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smokeball.com/notifications/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a specified notification."
        },
        {
          "info": {
            "name": "Create a notification",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.smokeball.com/notifications",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a notification."
        }
      ]
    }
  ],
  "bundled": true
}